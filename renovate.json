{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["flux"],
  "flux": {
    "managerFilePatterns": ["/^clusters/.+\\.ya?ml$/", "/^bases/.+\\.ya?ml$/"]
  },
  "schedule": ["* * * * 1"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "description": "App manifest artifacts (OCIRepository tags) are promotions: open the PR as soon as a release is pushed instead of waiting for the weekly window.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/hwinther/*/manifests", "ghcr.io/wshno/*/manifests"],
      "schedule": ["at any time"]
    },
    {
      "description": "clutterstock production is promoted by ClutterStock's promote.yml (approval + co-sign), not by Renovate.",
      "matchFileNames": ["clusters/production/apps/clutterstock/**"],
      "enabled": false
    }
  ]
}
