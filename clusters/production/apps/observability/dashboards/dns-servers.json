    {
      "id": 10,
      "type": "timeseries",
      "title": "Responses by rcode",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rcode) (rate(bind_response_rcodes_total{instance=~\"$instance\"}[$__rate_interval])) > 0",
          "legendFormat": "{{rcode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "REFUSED is mostly the internet asking an authoritative server for names it does not serve (allow-query / allow-recursion doing their job). NXDOMAIN spikes can be a misconfigured client or a random-subdomain flood.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests by opcode (excluding QUERY)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (opcode, instance) (rate(bind_incoming_requests_total{opcode!=\"QUERY\",instance=~\"$instance\"}[$__rate_interval])) > 0",
          "legendFormat": "{{instance}} {{opcode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "NOTIFY (zone change announcements between primary and secondaries) and UPDATE (dynamic DNS). QUERY is in the panels above.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
