    {
      "id": 19,
      "type": "table",
      "title": "Zone serials",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bind_zone_serial > 1",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "description": "SOA serial per zone and server (built-in empty zones, serial 0/1, are hidden). On a signed primary this is the signed serial. Split-horizon zones (oh.wsh.no) show unrelated public and LAN serials in one row; otherwise a row with different values is a secondary that has not caught up.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "instance",
            "rowField": "zone_name",
            "valueField": "Value"
          }
        }
      ]
