    {
      "id": 13,
      "type": "timeseries",
      "title": "Resolver latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, instance) (rate(bind_resolver_query_duration_seconds_bucket{view=\"_default\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(bind_resolver_query_duration_seconds_bucket{view=\"_default\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Round-trip time of the queries named sends upstream when it recurses. The exporter's buckets are coarse (10 ms, 100 ms, 500 ms, 800 ms, 1.6 s), so read this as a trend.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
