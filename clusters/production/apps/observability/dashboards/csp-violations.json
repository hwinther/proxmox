{
  "uid": "csp-violations",
  "title": "CSP violations",
  "tags": [
    "security",
    "csp"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "description": "Content-Security-Policy reports from app SSR servers (csp.violation log records in Loki). enforce = blocked, report = Report-Only.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "clutterstock-frontend-ssr",
        "options": [
          {
            "text": "clutterstock-frontend-ssr",
            "value": "clutterstock-frontend-ssr",
            "selected": true
          }
        ],
        "current": {
          "text": [
            "clutterstock-frontend-ssr"
          ],
          "value": [
            "clutterstock-frontend-ssr"
          ]
        },
        "multi": true,
        "includeAll": false,
        "description": "SSR services that emit csp.violation records. Add more, comma-separated, as apps get a report endpoint."
      },
      {
        "name": "namespace",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_namespace",
          "stream": "{service_name=~\"$service\"}",
          "type": 1
        },
        "definition": "label_values({service_name=~\"$service\"}, service_namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Blocked (enforce)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" | csp_disposition=\"enforce\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "The browser refused the resource: a page was broken for a user. Alerts via CspBlockedResource.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reported only (report-only)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" | csp_disposition=\"report\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Would have been blocked under CSP_MODE=enforce. Should stay at zero for a while before flipping to enforce.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pages affected",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "count(sum by (csp_document_uri) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "description": "Distinct document URIs (path only; the app strips query and fragment) with at least one violation.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Distinct blocked URIs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "count(sum by (csp_blocked_uri) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "description": "Distinct things browsers objected to: 'inline', 'eval', or a resource origin+path.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Violations over time: blocked vs report-only",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (csp_disposition) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__auto]))",
          "legendFormat": "{{csp_disposition}}"
        }
      ],
      "description": "enforce = blocked by the browser; report = Report-Only policy, nothing was blocked.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "enforce"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "report"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Violations by directive",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (csp_effective_directive, csp_disposition) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__auto]))",
          "legendFormat": "{{csp_effective_directive}} ({{csp_disposition}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Violations by environment",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (service_namespace, csp_disposition) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__auto]))",
          "legendFormat": "{{service_namespace}} ({{csp_disposition}})"
        }
      ],
      "description": "service_namespace comes from OTEL_RESOURCE_ATTRIBUTES; reports from before it was set have an empty namespace.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top blocked URIs (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(20, sum by (csp_blocked_uri, csp_effective_directive, csp_disposition) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "description": "What the policy objected to. 'inline' = inline script/style without the nonce, 'eval' = eval/new Function.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "csp_blocked_uri": "Blocked URI",
              "csp_effective_directive": "Directive",
              "csp_disposition": "Disposition",
              "Value": "Reports"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Reports",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top pages (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(20, sum by (csp_document_uri, csp_disposition) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "description": "Where the violations happened.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "csp_document_uri": "Page",
              "csp_disposition": "Disposition",
              "Value": "Reports"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Reports",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top sources (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(20, sum by (csp_source_file, csp_line_number, csp_sample) (count_over_time({service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\" | csp_source_file != \"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "description": "The script that triggered the violation, when the browser reports it. chrome-extension:// and moz-extension:// sources are users' browser add-ons, not the app.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "csp_source_file": "Source file",
              "csp_line_number": "Line",
              "csp_sample": "Sample",
              "Value": "Reports"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Reports",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Raw reports",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=~\"$service\", service_namespace=~\"$namespace\"} | event_name=\"csp.violation\""
        }
      ],
      "description": "Every report with its structured metadata (expand a line). The endpoint is public: check user_agent_original and csp_document_uri before trusting a single report.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
