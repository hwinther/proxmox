{
  "uid": "kubescape-vulnerabilities",
  "title": "Kubescape Vulnerabilities",
  "tags": [
    "kubescape",
    "security"
  ],
  "description": "Image CVEs per severity from Kubescape's prometheus-exporter (production and edge-sdr). Headlamp \u2192 Kubescape has the CVE lists.",
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kubescape_vulnerabilities_total_cluster_critical, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(kubescape_vulnerabilities_total_cluster_critical, cluster)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Critical",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (cluster) (kubescape_vulnerabilities_total_cluster_critical{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-red"
          }
        },
        "overrides": []
      },
      "description": "Critical CVEs across every scanned image in the cluster (Kubescape counts each workload container's image). The current count (an instant query): a range query over the dashboard's 30 days uses a step of hours, which can land before the first sample of a series that is younger than one step.",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "High",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (cluster) (kubescape_vulnerabilities_total_cluster_high{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "description": "High CVEs across every scanned image in the cluster (Kubescape counts each workload container's image). The current count (an instant query): a range query over the dashboard's 30 days uses a step of hours, which can land before the first sample of a series that is younger than one step.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Medium",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (cluster) (kubescape_vulnerabilities_total_cluster_medium{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "description": "Medium CVEs across every scanned image in the cluster (Kubescape counts each workload container's image). The current count (an instant query): a range query over the dashboard's 30 days uses a step of hours, which can land before the first sample of a series that is younger than one step.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Low",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (cluster) (kubescape_vulnerabilities_total_cluster_low{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "description": "Low CVEs across every scanned image in the cluster (Kubescape counts each workload container's image). The current count (an instant query): a range query over the dashboard's 30 days uses a step of hours, which can land before the first sample of a series that is younger than one step.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Critical and high over time",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (cluster) (kubescape_vulnerabilities_total_cluster_critical{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} critical",
          "refId": "A"
        },
        {
          "expr": "sum by (cluster) (kubescape_vulnerabilities_total_cluster_high{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} high",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "table",
      "title": "Own images (ghcr.io/hwinther, ghcr.io/wshno)",
      "description": "Workloads running an image we build. Critical > 0 here fires KubescapeOwnImageCriticalVulnerabilities.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_critical{cluster=~\"$cluster\"}) * on (namespace, workload, workload_kind, workload_container_name) group_left () wsh:own_image_container:info",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_high{cluster=~\"$cluster\"}) * on (namespace, workload, workload_kind, workload_container_name) group_left () wsh:own_image_container:info",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_medium{cluster=~\"$cluster\"}) * on (namespace, workload, workload_kind, workload_container_name) group_left () wsh:own_image_container:info",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_low{cluster=~\"$cluster\"}) * on (namespace, workload, workload_kind, workload_container_name) group_left () wsh:own_image_container:info",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "pod": true,
              "endpoint": true,
              "container": true,
              "namespace_1": true
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "workload_kind": 2,
              "workload": 3,
              "workload_container_name": 4,
              "Value #A": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8
            },
            "renameByName": {
              "workload_kind": "kind",
              "workload_container_name": "container",
              "Value #A": "critical",
              "Value #B": "high",
              "Value #C": "medium",
              "Value #D": "low"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "critical",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "dark-red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "table",
      "title": "All workloads",
      "description": "Every scanned workload container, worst first. Third-party images are fixed upstream; this shows where the risk sits.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_critical{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_high{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_medium{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "max by (cluster, namespace, workload, workload_kind, workload_container_name) (kubescape_vulnerabilities_total_workload_low{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "pod": true,
              "endpoint": true,
              "container": true,
              "namespace_1": true
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "workload_kind": 2,
              "workload": 3,
              "workload_container_name": 4,
              "Value #A": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8
            },
            "renameByName": {
              "workload_kind": "kind",
              "workload_container_name": "container",
              "Value #A": "critical",
              "Value #B": "high",
              "Value #C": "medium",
              "Value #D": "low"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "critical",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "dark-red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Critical by namespace (top 20)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "topk(20, sum by (cluster, namespace) (kubescape_vulnerabilities_total_namespace_critical{cluster=~\"$cluster\"}))",
          "legendFormat": "{{cluster}} / {{namespace}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-red"
          }
        },
        "overrides": []
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ]
}
